{
  "name": "@rinova/devtools",
  "version": "0.1.0",
  "description": "框架无关的开发者调试工具：环境配置、网络、存储、日志与插件扩展",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "lucide": "1.68.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "less": "4.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "keywords": [
    "devtools",
    "debug",
    "vue",
    "react",
    "framework-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jove-rina/rinova-devtools"
  }
}
